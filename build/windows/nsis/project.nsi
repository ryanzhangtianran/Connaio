Unicode true

# The Windows installer: connaio.exe, connaio-core.exe and wintun.dll into Program Files, for every
# user (admin). makensis gets the binaries and the version as defines (build/windows/Taskfile.yml):
#   makensis -DINFO_PRODUCTVERSION=1.0.0-rc.1 -DINFO_VERSION_NUM=1.0.0 -DARG_WAILS_AMD64_BINARY=..\..\..\bin\connaio.exe -DARG_CORE_BINARY=... -DARG_WINTUN=... project.nsi
# wails_tools.nsh is generated by `wails3 update build-assets` from build/config.yml.
!include "wails_tools.nsh"

# The version information for this two must consist of 4 parts, numbers only (no -rc.1)
VIProductVersion "${INFO_VERSION_NUM}.0"
VIFileVersion    "${INFO_VERSION_NUM}.0"

VIAddVersionKey "CompanyName"     "${INFO_COMPANYNAME}"
VIAddVersionKey "FileDescription" "${INFO_PRODUCTNAME} Installer"
VIAddVersionKey "ProductVersion"  "${INFO_PRODUCTVERSION}"
VIAddVersionKey "FileVersion"     "${INFO_PRODUCTVERSION}"
VIAddVersionKey "LegalCopyright"  "${INFO_COPYRIGHT}"
VIAddVersionKey "ProductName"     "${INFO_PRODUCTNAME}"

# Enable HiDPI support. https://nsis.sourceforge.io/Reference/ManifestDPIAware
ManifestDPIAware true

!include "MUI.nsh"

!define MUI_ICON "..\icon.ico"
!define MUI_UNICON "..\icon.ico"
!define MUI_FINISHPAGE_NOAUTOCLOSE # Wait on the INSTFILES page so the user can take a look into the details of the installation steps
!define MUI_ABORTWARNING # This will warn the user if they exit from the installer.

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "SimpChinese"
!insertmacro MUI_LANGUAGE "English"

# The root core's service and data dir, as internal/daemon installs them on Windows.
!define CORE_SERVICE "ConnaioCore"
!define CORE_DATA "$APPDATA\Connaio Core" # C:\ProgramData under SetShellVarContext all

Name "${INFO_PRODUCTNAME}"
OutFile "..\..\..\bin\${INFO_PRODUCTNAME}-${INFO_PRODUCTVERSION}-windows-${ARCH}.exe" # what the updater and the release expect
InstallDir "$PROGRAMFILES64\${INFO_PRODUCTNAME}"
ShowInstDetails show

Function .onInit
   !insertmacro wails.checkArchitecture
FunctionEnd

# stopCore ends a running GUI and root core, so their files can be replaced; the service is left
# installed and starts again on the new binary.
# quiet runs a command without logging it: "process not found" and "service not started" are the normal case.
!macro quiet cmd
    nsExec::Exec '${cmd}'
    Pop $0
!macroend

!macro stopCore
    !insertmacro quiet 'taskkill /F /IM ${PRODUCT_EXECUTABLE}'
    !insertmacro quiet 'sc stop ${CORE_SERVICE}'
    !insertmacro quiet 'taskkill /F /IM connaio-core.exe'
    Sleep 1000
!macroend

# urlScheme makes Connaio the handler of scheme:// links; dropUrlScheme undoes it while still ours,
# not when another client has taken the scheme since
!macro urlScheme scheme
    WriteRegStr SHCTX "Software\Classes\${scheme}" "" "URL:${scheme}"
    WriteRegStr SHCTX "Software\Classes\${scheme}" "URL Protocol" ""
    WriteRegStr SHCTX "Software\Classes\${scheme}\shell\open\command" "" '"$INSTDIR\${PRODUCT_EXECUTABLE}" "%1"'
!macroend
!macro dropUrlScheme scheme
    ReadRegStr $0 SHCTX "Software\Classes\${scheme}\shell\open\command" ""
    StrCmp $0 '"$INSTDIR\${PRODUCT_EXECUTABLE}" "%1"' 0 +2
        DeleteRegKey SHCTX "Software\Classes\${scheme}"
!macroend

Section
    !insertmacro wails.setShellContext

    !insertmacro wails.webview2runtime

    !insertmacro stopCore

    SetOutPath $INSTDIR

    !insertmacro wails.files
    File "/oname=connaio-core.exe" "${ARG_CORE_BINARY}"
    File "/oname=wintun.dll" "${ARG_WINTUN}"

    CreateShortcut "$SMPROGRAMS\${INFO_PRODUCTNAME}.lnk" "$INSTDIR\${PRODUCT_EXECUTABLE}"
    CreateShortCut "$DESKTOP\${INFO_PRODUCTNAME}.lnk" "$INSTDIR\${PRODUCT_EXECUTABLE}"

    !insertmacro quiet 'sc start ${CORE_SERVICE}' # only exists once enhanced mode installed it

    # clash:// and connaio:// links (a provider's 一键导入) open Connaio, the link its argument
    !insertmacro urlScheme clash
    !insertmacro urlScheme connaio

    !insertmacro wails.writeUninstaller
SectionEnd

Section "uninstall"
    !insertmacro wails.setShellContext

    !insertmacro stopCore
    nsExec::ExecToLog 'sc delete ${CORE_SERVICE}'
    RMDir /r "${CORE_DATA}"

    RMDir /r "$AppData\${PRODUCT_EXECUTABLE}" # Remove the WebView2 DataPath

    RMDir /r $INSTDIR

    Delete "$SMPROGRAMS\${INFO_PRODUCTNAME}.lnk"
    Delete "$DESKTOP\${INFO_PRODUCTNAME}.lnk"

    !insertmacro dropUrlScheme clash
    !insertmacro dropUrlScheme connaio

    !insertmacro wails.deleteUninstaller
SectionEnd
