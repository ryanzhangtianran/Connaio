# Connaio with no window, driven by its command line (the headless build). install.sh puts it in
# /opt/connaio and this file in /etc/systemd/system/; then
#   systemctl enable --now connaio
#   journalctl -u connaio     # its log (the command line's token: /var/lib/connaio-web/web-token)
# Run as root, TUN mode can be turned on. The listen address is /etc/default/connaio's CONNAIO_LISTEN:
# kept there (not here) so an update, which replaces this file, keeps it.
[Unit]
Description=Connaio
After=network-online.target
Wants=network-online.target

[Service]
Environment=CONNAIO_LISTEN=127.0.0.1:9090
EnvironmentFile=-/etc/default/connaio
ExecStart=/opt/connaio/connaio --listen ${CONNAIO_LISTEN} --data-dir /var/lib/connaio-web
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
