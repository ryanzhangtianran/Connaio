# connaio-server: Connaio with no window, its UI in a browser. Unpack the release's
# Connaio-*-linux-*-server.tar.gz into /opt/connaio, copy this file to /etc/systemd/system/, then
#   systemctl enable --now connaio-server
#   journalctl -u connaio-server     # the web UI's address and access token
# Root lets enhanced mode (TUN) run; without it, drop User= lines and enhanced mode stays off.
[Unit]
Description=Connaio (web UI)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/connaio/connaio-server --listen 127.0.0.1:9090 --data-dir /var/lib/connaio-server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
